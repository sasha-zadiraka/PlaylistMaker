<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSecondary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playerScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSecondary"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/left_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="24dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/right_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="24dp" />

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@null"
                android:scaleType="center"
                android:src="@drawable/ic_back_arrow_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/coverArtwork"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="24dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cover_placeholder_233"
                app:layout_constraintBottom_toTopOf="@id/trackName"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/buttonBack" />

            <TextView
                android:id="@+id/trackName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_medium"
                android:maxLines="2"
                android:textColor="?attr/colorPrimary"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/coverArtwork" />

            <TextView
                android:id="@+id/artistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_medium"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/trackName" />

            <ImageButton
                android:id="@+id/buttonAddToPlaylist"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginTop="52dp"
                android:background="@drawable/bg_player_secondary_button"
                android:padding="14dp"
                android:src="@drawable/ic_add_to_playlist_23"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/artistName"
                app:tint="@color/white" />

            <com.playlistmaker.player.ui.PlaybackButtonView
                android:id="@+id/buttonPlay"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:padding="28dp"
                app:layout_constraintBottom_toBottomOf="@id/buttonFavorite"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/buttonFavorite"
                app:pauseIcon="@drawable/ic_pause_83"
                app:playIcon="@drawable/ic_play_83" />

            <ImageButton
                android:id="@+id/buttonFavorite"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginTop="52dp"
                android:background="@drawable/bg_player_secondary_button"
                android:padding="14dp"
                android:src="@drawable/ic_add_to_favorite_23"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintTop_toBottomOf="@id/artistName" />

            <TextView
                android:id="@+id/progressValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ys_display_medium"
                android:gravity="center"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@id/buttonPlay"
                app:layout_constraintStart_toStartOf="@id/buttonPlay"
                app:layout_constraintTop_toBottomOf="@id/buttonPlay" />

            <TextView
                android:id="@+id/durationLabel"
                style="@style/PlayerMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginTop="40dp"
                android:text="@string/screen_player_track_length"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressValue" />

            <TextView
                android:id="@+id/durationValue"
                style="@style/PlayerMetaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/big_padding"
                app:layout_constraintBaseline_toBaselineOf="@id/durationLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/albumLabel"
                style="@style/PlayerMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginTop="16dp"
                android:text="@string/screen_player_track_album"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/durationLabel" />

            <TextView
                android:id="@+id/collectionValue"
                style="@style/PlayerMetaValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="@dimen/big_padding"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="2"
                app:layout_constraintBaseline_toBaselineOf="@id/albumLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/albumLabel" />

            <TextView
                android:id="@+id/yearLabel"
                style="@style/PlayerMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginTop="16dp"
                android:text="@string/screen_player_track_year"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/albumLabel" />

            <TextView
                android:id="@+id/yearValue"
                style="@style/PlayerMetaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/big_padding"
                app:layout_constraintBaseline_toBaselineOf="@id/yearLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/genreLabel"
                style="@style/PlayerMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginTop="16dp"
                android:text="@string/screen_player_track_genre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/yearLabel" />

            <TextView
                android:id="@+id/genreValue"
                style="@style/PlayerMetaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/big_padding"
                app:layout_constraintBaseline_toBaselineOf="@id/genreLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/countryLabel"
                style="@style/PlayerMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginTop="16dp"
                android:text="@string/screen_player_track_country"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/genreLabel" />

            <TextView
                android:id="@+id/countryValue"
                style="@style/PlayerMetaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/big_padding"
                app:layout_constraintBaseline_toBaselineOf="@id/countryLabel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yp_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/playlistsBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_playlists_bottom_sheet"
        android:minHeight="300dp"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/ys_display_medium"
            android:gravity="center"
            android:text="@string/screen_player_add_to_playlist_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="19sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newPlaylistButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:backgroundTint="?attr/colorPrimary"
            android:fontFamily="@font/ys_display_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/screen_media_library_new_playlist_button"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimaryFixed"
            android:textSize="14sp"
            app:cornerRadius="18dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="8dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>